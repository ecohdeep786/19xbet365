# 19xbet365 environment
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres@127.0.0.1:5433/astra_play
PG_POOL_MAX=10
DEMO_MATCH_MINUTES=90
DEMO_SETTLEMENT_INTERVAL_MS=60000
# Set DEMO_SETTLEMENT=off to disable the demo sports settlement worker.
# Live collection also requires depositMode=manual_review, a verified QR and
# completed licensing, KYC/AML and payment onboarding.
PAYMENTS_LIVE_ENABLED=false

# Firebase Authentication. The project ID is used to verify Firebase ID tokens
# against Google's public signing certificates; no service-account secret is
# required for token verification.
FIREBASE_PROJECT_ID=xbet365-ab8fb
# Optional: only needed if server-side Firestore/Admin writes are added later.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
